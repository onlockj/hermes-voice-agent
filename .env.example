# ── Required ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=                       # free at console.groq.com
WEBAPP_URL=                         # public https root (e.g. https://username-hermes.hf.space)

# ── TTS (pick at least one path) ─────────────────────────────────
# ElevenLabs free tier: 10,000 chars/month, premium voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB   # Adam — change to any voice ID
ELEVENLABS_MODEL=eleven_flash_v2_5         # ~75ms TTFB

# Fallback / fully-free option: Microsoft Edge TTS (unlimited, no key).
TTS_PROVIDER=auto                  # auto | elevenlabs | edge
EDGE_TTS_VOICE=en-US-GuyNeural

# ── Models (free Groq) ───────────────────────────────────────────
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ── Auth ─────────────────────────────────────────────────────────
ALLOWED_USER_IDS=                  # CSV of telegram user IDs (empty = open)

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
