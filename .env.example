# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key with Realtime API access
OPENAI_API_KEY=

# Public URL of THIS app (no trailing slash). Used for webhook + WebApp button.
# Example: https://hermes.your-domain.com
WEBAPP_URL=

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone who can message the bot.
ALLOWED_USER_IDS=

# OpenAI Realtime model
MODEL=gpt-4o-realtime-preview-2024-10-01

# Voice: alloy, echo, shimmer, ash, ballad, coral, sage, verse
VOICE=ash

# Server bind
HOST=0.0.0.0
PORT=8080
